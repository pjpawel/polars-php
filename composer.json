    "type": "php-ext",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "pjpawel",
            "email": "pawel.jan.podgorski@gmail.com"
        }
    ],
    "homepage": "https://pjpawel.github.io/polars-php/",
